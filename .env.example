# Chạy local hay Docker thì KHÔNG cần file này — bỏ trống hết vẫn chạy,
# dữ liệu tự ghi vào data/db.json.

# Đổi chỗ lưu file JSON (local/Docker).
# DATA_FILE="data/db.json"

# --- chỉ dùng khi deploy Vercel ---

# Vercel tự thêm khi bạn tạo Blob store (Storage → Blob). Có biến này thì
# DATA_FILE bị bỏ qua và dữ liệu nằm trên blob thay vì ổ đĩa.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Nên đặt tay: blob là public, để mặc định thì ai đoán trúng URL là đọc được
# cả webhook Discord trong file. Cho một chuỗi ngẫu nhiên vào đây.
# BLOB_PATH="vietjet-fare-watcher/db-<chuỗi-ngẫu-nhiên>.json"

# Nên đặt tay: có biến này thì /api/cron đòi Authorization: Bearer <secret>,
# không ai ngoài Vercel Cron gọi được.
# CRON_SECRET="..."
