generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model WatchConfig {
  id               String   @id @default(cuid())
  name             String
  enabled          Boolean  @default(true)

  tripType         String   @default("oneway") // "oneway" | "roundtrip"
  origin           String
  dest             String

  departFrom       String   // "YYYY-MM-DD"
  departTo         String
  returnFrom       String?
  returnTo         String?

  minPrice         Int      @default(0)
  maxPrice         Int

  discordWebhookUrl String
  pollMinutes      Int      @default(20) // quét lại sau bao nhiêu phút

  lastRunAt        DateTime?
  lastError        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  alerts           Alert[]
}

model Alert {
  id          String   @id @default(cuid())
  configId    String
  config      WatchConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  fingerprint String   @unique

  origin      String
  dest        String
  departDate  String
  returnDate  String?
  price       Int
  flightNo    String?
  deeplink    String?

  notifiedAt  DateTime @default(now())

  @@index([configId, notifiedAt])
}

/// Cài đặt chung, chỉ có đúng một dòng (id = "singleton").
model AppSetting {
  id        String   @id @default("singleton")
  running   Boolean  @default(false) // bật/tắt bằng nút Start trên web
  updatedAt DateTime @updatedAt
}
